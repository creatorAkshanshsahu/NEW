<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp" android:layout_height="124dp" android:layout_margin="8dp"
    android:focusable="true" android:clickable="true" android:background="@drawable/card_bg">
    <ImageView android:id="@+id/logo" android:layout_width="64dp" android:layout_height="64dp"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="16dp" android:scaleType="fitCenter"/>
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_marginBottom="12dp" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF"
        android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="10dp"
        android:text="● LIVE" android:textColor="#FF375F" android:textSize="9sp" android:fontFamily="sans-serif-medium"/>
    <TextView android:id="@+id/fav" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="9dp" android:text="♥" android:textColor="#FF375F"
        android:textSize="16sp" android:visibility="gone"/>
</FrameLayout>
