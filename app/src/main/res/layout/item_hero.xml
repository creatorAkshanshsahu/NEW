<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginTop="8dp"
    android:layout_marginBottom="6dp" android:background="@drawable/hero_bg">
    <LinearLayout android:id="@+id/heroBox" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="40dp" android:paddingEnd="40dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/heroBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FF375F" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.15"/>
            <TextView android:id="@+id/heroTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF"
                android:textSize="38sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/heroSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="#B0B0BA" android:textSize="15sp"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/heroArt" android:layout_width="170dp" android:layout_height="170dp">
            <ImageView android:id="@+id/heroLogo" android:layout_width="110dp" android:layout_height="110dp"
                android:layout_gravity="center" android:scaleType="fitCenter"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
