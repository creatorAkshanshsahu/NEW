<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="760dp" android:layout_height="wrap_content" android:orientation="horizontal"
    android:padding="28dp" android:background="@drawable/dialog_bg">
    <ImageView android:id="@+id/dPoster" android:layout_width="190dp" android:layout_height="270dp" android:scaleType="centerCrop"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="28dp" android:orientation="vertical">
        <TextView android:id="@+id/dTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="26sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/dMeta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="#0A84FF" android:textSize="13sp"/>
        <TextView android:id="@+id/dDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:maxLines="6" android:ellipsize="end" android:textColor="#C7C7CC" android:textSize="14sp"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
            <TextView android:id="@+id/dPlay" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="40dp" android:paddingEnd="40dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:text="▶  Play" android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                android:focusable="true" android:clickable="true" android:background="@drawable/btn_bg"><requestFocus/></TextView>
            <TextView android:id="@+id/dClose" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="12dp"
                android:paddingBottom="12dp" android:text="Close" android:textColor="#FFFFFF" android:textSize="16sp"
                android:fontFamily="sans-serif-medium" android:focusable="true" android:clickable="true" android:background="@drawable/btn_bg"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
